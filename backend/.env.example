# ─── Server ───
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ─── MongoDB (must be a replica set for transactions — Atlas works out of the box) ───
MONGO_URI=your_mongodb_connection_string

# ─── Auth / JWT ───
JWT_SECRET=your_jwt_secret_key
ACCESS_TOKEN_TTL=15m          # short-lived access token
REFRESH_TOKEN_TTL_DAYS=7      # long-lived refresh token (httpOnly cookie)

# ─── Redis (rate limiting, caching, job queue) ───
REDIS_URL=redis://127.0.0.1:6379
# DISABLE_REDIS=true          # set to use in-memory fallbacks instead of Redis

# ─── Razorpay ───
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret   # added in Phase 3

# ─── Fast2SMS (OTP delivery) ───
FAST2SMS_API_KEY=your_fast2sms_api_key

# ─── Google Gemini AI (chatbot) ───
GEMINI_API_KEY=your_gemini_api_key

# ─── Email (Gmail app password) ───
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16_char_app_password
