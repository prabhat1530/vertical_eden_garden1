# ─── Server ───
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ─── MongoDB (must be a replica set for transactions — Atlas works out of the box) ───
MONGO_URI=your_mongodb_connection_string

# ─── Auth / JWT ───
JWT_SECRET=your_jwt_secret_key
ACCESS_TOKEN_TTL=15m          # short-lived access token
REFRESH_TOKEN_TTL_DAYS=7      # long-lived refresh token (httpOnly cookie)

# ─── Proxies in front of the app (Render: Cloudflare + load balancer) ───
# Measure with GET /api/ip: correct when "ip" equals your real public IP.
TRUST_PROXY=1                 # Render production value: 3

# ─── Redis (rate limiting, caching, email job queue) ───
# Without REDIS_URL: rate limits count in memory, no caching, and emails are
# sent once with no retries.
REDIS_URL=redis://127.0.0.1:6379
# DISABLE_REDIS=true          # set to use in-memory fallbacks instead of Redis

# ─── Email queue ───
EMAIL_RETRY_DELAY_MS=30000    # first retry after 30s, then 1m, 2m, 4m (5 attempts)
# EMAIL_SIMULATE_FAILURES=2   # DEV/DEMO ONLY: first N attempts of every email fail

# ─── Razorpay ───
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret   # added in Phase 3

# ─── Fast2SMS (OTP delivery) ───
FAST2SMS_API_KEY=your_fast2sms_api_key

# ─── Google Gemini AI (chatbot) ───
GEMINI_API_KEY=your_gemini_api_key

# ─── Email (Gmail app password) ───
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16_char_app_password
